{
    "_readme": "Seed config for OpenWebRX on Fancy's RTL-SDR, applied on top of the image defaults. Apply: docker cp configs/openwebrx/settings.json openwebrx:/var/lib/openwebrx/settings.json then docker restart openwebrx. Verify: docker logs openwebrx shows no 'out of range' warnings and curl 127.0.0.1:8073 returns 200. Rollback: delete /var/lib/openwebrx/settings.json from the volume and restart to fall back to OpenWebRX's built-in defaults. OpenWebRX ignores this key.",
    "version": 7,
    "receiver_name": "Fancy — uConsole AIO V2",
    "receiver_location": "Maidenhead grid only",
    "sdrs": {
        "rtlsdr": {
            "name": "AIO V2 RTL-SDR (R820T)",
            "type": "rtl_sdr",
            "rf_gain": "auto",
            "profiles": {
